        <mxCell id="e52" edge="1" parent="1" source="pr1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=light-dark(#000000,#FFFFFF);" target="up1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e53" edge="1" parent="1" source="up1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=light-dark(#000000,#FFFFFF);" target="cl1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bandBug" parent="1" style="rounded=0;fillColor=none;strokeColor=#b85450;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacing=8;html=1;fontColor=light-dark(#000000,#FFFFFF);" value="RAMO BUG (variante F1-F2) — TDD da regressione" vertex="1">
          <mxGeometry height="150" width="1100" x="40" y="1790" as="geometry" />
        </mxCell>
        <mxCell id="r1" parent="1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=light-dark(#FFFFFF,#000000);" value="Riproduzione: caso minimo&lt;br&gt;(changelog per l&#39;origine)&lt;br&gt;→ SOLO DOPO si valuta il fast-path" vertex="1">
          <mxGeometry height="75" width="260" x="60" y="1830" as="geometry" />
        </mxCell>
        <mxCell id="r2" parent="1" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;RED-test&lt;/b&gt; (test-author) che cattura il bug&lt;br&gt;→ fix → GREEN → il red-test entra&lt;br&gt;stabilmente nella suite di non-regression" vertex="1">
          <mxGeometry height="75" width="320" x="380" y="1830" as="geometry" />
        </mxCell>
        <mxCell id="eb1" edge="1" parent="1" source="r1" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=light-dark(#000000,#FFFFFF);" target="r2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="sb1" parent="1" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=10;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;STATO PER-TASK&lt;/b&gt;&lt;br&gt;.ai-dev/tasks/&amp;lt;id&amp;gt;/state.json — unico accesso: bin/flowState.mjs&lt;br&gt;&lt;br&gt;Registro di FATTI, non workflow engine: fase, gate approvati, branch+base, snapshot, verifiche (hash diff), doc-review, changelog, ticket, PR, DEROGHE motivate + log.&lt;br&gt;&lt;br&gt;★ Gli hook fanno rispettare i contratti di fase&lt;br&gt;★ Un task interrotto RIPRENDE da dov&#39;era&lt;br&gt;★ Un collega può SUBENTRARE (stato committabile)&lt;br&gt;★ Sacrificabile: punta agli artefatti, non li contiene" vertex="1">
          <mxGeometry height="290" width="420" x="1180" y="360" as="geometry" />
        </mxCell>
        <mxCell id="sb2" parent="1" style="rounded=1;html=1;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=top;spacing=10;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;GUARDIANI (hook — scattano SEMPRE)&lt;/b&gt;&lt;br&gt;&lt;br&gt;• versionDrift (SessionStart): drift versione + task in corso, VISIBILI all&#39;utente&lt;br&gt;• preEditGuard: test read-only · niente codice senza spec+piano+branch · mai sul branch base&lt;br&gt;• preBashGuard: test read-only anche via shell&lt;br&gt;• perimeterGuard: solo componenti del kit&lt;br&gt;• preWorkSnapshot: &quot;before&quot; sui dati, a codice pristino&lt;br&gt;• postWorkVerification (Stop): verifica per hash del diff + checklist di chiusura&lt;br&gt;&lt;br&gt;Ogni valvola di sfogo = skip umano, motivato, registrato." vertex="1">
          <mxGeometry height="300" width="420" x="1180" y="670" as="geometry" />
        </mxCell>
        <mxCell id="sb3" parent="1" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=10;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;PERIMETRO DELLO STANDARD (enforced)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nei progetti col kit si usano SOLO componenti del kit (+ Ponytail, abilitato dal kit). Skill personali e server MCP utente: BLOCCATI dall&#39;hook.&lt;br&gt;Eccezioni: whitelist esplicite in flow.config.perimeter — decisione umana, committata." vertex="1">
          <mxGeometry height="170" width="420" x="1180" y="990" as="geometry" />
        </mxCell>
        <mxCell id="sb4" parent="1" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;AGENTI PER FASE — modello per natura del lavoro&lt;/b&gt;&lt;br&gt;&lt;br&gt;F0 intake → haiku (parsing meccanico)&lt;br&gt;F1 spec-author → opus (fase a più leverage)&lt;br&gt;F2 plan-author → opus (il COSA diventa COME: unica lettura profonda della codebase)&lt;br&gt;F2 test-author → sonnet (derivazione resa meccanica dagli osservabili, ISOLATO)&lt;br&gt;F2 codice → thread principale, tier di progetto (esegue un piano approvato)&lt;br&gt;F3 test-runner → haiku (esegue e riporta)&lt;br&gt;F4 doc-author → sonnet (scrittura fedele)&lt;br&gt;F5 — (meccanica pura: script/hook)&lt;br&gt;&lt;br&gt;I sub-agent ricevono SOLO i loro input dichiarati (contratti fisici). I GATE restano SEMPRE all&#39;orchestratore (skill flow): gli agenti preparano, l&#39;utente decide.&lt;br&gt;&lt;br&gt;&lt;b&gt;Il tier NON si sovrascrive alla chiamata&lt;/b&gt; (0.2.0): il parametro `model` batte il frontmatter e disattiva il tiering. Si corregge il frontmatter, non la chiamata." vertex="1">
          <mxGeometry height="360" width="420" x="1180" y="1180" as="geometry" />
        </mxCell>
        <mxCell id="sb5" parent="1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=10;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;ENTRYPOINT: skill `flow` + SEQUENCER&lt;/b&gt;&lt;br&gt;&lt;br&gt;«Lavora su questo ticket» → l&#39;orchestratore esegue un loop deterministico: &lt;b&gt;flowState next&lt;/b&gt; (il prossimo passo calcolato dai FATTI) → esegui → registra → next. La direzione del flusso è codice, non memoria dell&#39;LLM (niente SPOF cognitivo); i gate restano dialogo umano. Abbandono governato: &lt;b&gt;abort --reason&lt;/b&gt; con compensazioni (branch, ticket, snapshot). Doctor invocabile in ogni momento." vertex="1">
          <mxGeometry height="190" width="420" x="1180" y="1560" as="geometry" />
        </mxCell>
        <mxCell id="sb6" parent="1" style="rounded=1;html=1;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=10;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;STRATI&lt;/b&gt;: processo, artefatti .md e regole = AGNOSTICI dal tool · skill/hook/agenti/connettori = strato ADATTATORE Claude Code, sottile e sostituibile." vertex="1">
          <mxGeometry height="100" width="420" x="1180" y="1770" as="geometry" />
        </mxCell>
        <mxCell id="sb7" parent="1" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=10;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;ECONOMIA DEL CONTESTO (0.2.0)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Il costo di un task NON deve crescere col numero di task già svolti. Ciò che lo fa crescere è la RILETTURA.&lt;br&gt;&lt;br&gt;• changelog: testa &quot;Vincolante&quot; (max 15 righe) = l&#39;unica parte che le fasi a valle leggono · narrativa sotto la barriera&lt;br&gt;• spec in 2 parti: NORMATIVA (autosufficiente per il test-author) + motivazione&lt;br&gt;• misure dalla FONTE PRIMARIA (inputs/ di F0), mai di seconda mano&lt;br&gt;• osservabilità verificata PRIMA del gate: un emendamento post-gate = un secondo passaggio della fase più cara&lt;br&gt;• senza git: manifest &quot;prima&quot; → inventario del GATE 3 per CONFRONTO (record-manifest / diff-manifest)&lt;br&gt;&lt;br&gt;Non si taglia la separazione dei ruoli: sub-agent isolati, 3 gate umani, F4 come revisione. È il presidio che trova i difetti." vertex="1">
          <mxGeometry height="270" width="420" x="1180" y="1880" as="geometry" />
        </mxCell>
        <mxCell id="sb8" parent="1" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=10;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;TIER DEL THREAD E ESCALATION (0.3.0)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Principio: il modello top si paga dove si DECIDE, non dove si esegue.&lt;br&gt;&lt;br&gt;• spec e piano = sub-agent con opus nel frontmatter → garantiti anche se la sessione è su un tier più basso&lt;br&gt;• thread principale (orchestrazione + implementazione di un piano approvato) = default di progetto: flow.config.models.mainThread → &quot;model&quot; in .claude/settings.json&lt;br&gt;• l&#39;implementazione resta nel thread: è un LOOP con F3 (isolarla = ripartire da freddo a ogni rosso), le sue domande nascono a metà lavoro, ed è la fase dove l&#39;osservazione umana in corsa vale di più&lt;br&gt;&lt;br&gt;&lt;b&gt;ESCALATION&lt;/b&gt; (sempre umana, sempre registrata: record-override --gate model-tier):&lt;br&gt;• al GATE 2, informata dalle NOTE DI COMPLESSITÀ del plan-author (segnala, non decide)&lt;br&gt;• dopo i ROSSI, proposta dal SEQUENCER oltre la soglia models.escalateAfterRedRounds — segnale oggettivo, non stima ex-ante&lt;br&gt;&lt;br&gt;Limite dichiarato: il tier del thread è un DEFAULT, non un vincolo (l&#39;utente può /model). Il tier è economia; i presidi restano hook, gate e test scritti prima del codice." vertex="1">
          <mxGeometry height="380" width="420" x="1180" y="2190" as="geometry" />
        </mxCell>
        <mxCell id="sb9" parent="1" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=10;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;ECONOMIA DELL&#39;ATTENZIONE (0.4.0)&lt;/b&gt;&lt;br&gt;&lt;br&gt;Il flusso gira in automatico: la narrazione non viene letta, e sommerge le due cose che contano — i GATE e le DOMANDE. Regola: &lt;b&gt;poco mentre lavori, molto quando chiedi&lt;/b&gt;.&lt;br&gt;&lt;br&gt;• una RIGA per passo del sequencer (fase, esito, fatto registrato)&lt;br&gt;• gli ARTEFATTI non si incollano: spec e piano nascono su file (.ai-dev/tasks/&amp;lt;id&amp;gt;/spec-draft.md, plan-draft.md) e a schermo va il PERCORSO&lt;br&gt;• ai GATE: 5-15 righe per DECIDERE + percorso + cosa serve dall&#39;utente&lt;br&gt;• DOMANDA = cosa si decide · perché ora (con la fonte) · cosa cambia · 2-4 opzioni con conseguenza&lt;br&gt;• le domande dei sub-agent si RISCRIVONO, non si inoltrano: chi le ha scritte aveva spec e codice in testa, chi risponde non ha letto nulla&lt;br&gt;&lt;br&gt;Veicolo: output style consegnato dal plugin (output-styles/), selezionato per-progetto dall&#39;install. Mai imposto: resta una scelta dell&#39;utente." vertex="1">
          <mxGeometry height="380" width="420" x="1180" y="2610" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
