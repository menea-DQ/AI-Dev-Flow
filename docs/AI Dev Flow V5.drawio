        <mxCell id="pr1" parent="1" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;PR&lt;/b&gt;: branch di lavoro → branch base&lt;br&gt;(dallo stato; titolo dalla spec,&lt;br&gt;link a spec/changelog/ticket)" vertex="1">
          <mxGeometry height="75" width="270" x="60" y="1635" as="geometry" />
