        <mxCell id="up1" parent="1" style="rounded=1;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;Ticket aggiornato&lt;/b&gt; via connettore&lt;br&gt;--update-status (Review/Done —&lt;br&gt;stato scelto dall&#39;utente) — GARANTITO" vertex="1">
          <mxGeometry height="75" width="280" x="390" y="1635" as="geometry" />
        </mxCell>
        <mxCell id="cl1" parent="1" style="rounded=1;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=light-dark(#FFFFFF,#000000);" value="&lt;b&gt;STATO&lt;/b&gt;: flowState close&lt;br&gt;(lo state.json resta: audit trail)" vertex="1">
          <mxGeometry height="65" width="250" x="730" y="1640" as="geometry" />
        </mxCell>
        <mxCell id="e51" edge="1" parent="1" source="v2" style="edgeStyle=orthogonalEdgeStyle;html=1;fontColor=light-dark(#000000,#FFFFFF);" target="pr1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1070" y="1425" />
              <mxPoint x="1070" y="1560" />
