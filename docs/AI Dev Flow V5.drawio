        <mxCell id="band5" parent="1" style="rounded=0;fillColor=none;strokeColor=#b3b3b3;dashed=1;verticalAlign=top;align=left;fontStyle=1;fontSize=13;spacing=8;html=1;fontColor=light-dark(#000000,#FFFFFF);" value="FASE 5 · CONSEGNA" vertex="1">
          <mxGeometry height="180" width="1100" x="40" y="1590" as="geometry" />
